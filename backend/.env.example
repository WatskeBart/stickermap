LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_DBNAME=stickermap
DB_USER=user
DB_PASSWORD=password
UPLOAD_DIR=uploads

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=stickermap
KEYCLOAK_CLIENT_ID=stickermap-client
KEYCLOAK_CLIENT_SECRET=clientsecret

# HQ: the point distances are measured from (decimal degrees). Default: the Dutch national grid origin in Amersfoort.
HQ_LAT=52.155174
HQ_LON=5.387206
